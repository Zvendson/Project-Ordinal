{
    "name": "ordinal/project-ordinal",
    "description": "Project: Ordinal",
    "type": "project",
    "license": "GPL-3.0-only",
    "require": {
        "php": "~8.5.0",
        "ext-curl": "*",
        "ext-openssl": "*",
        "ext-pdo": "*",
        "ext-pdo_pgsql": "*",
        "ext-sodium": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.3"
    },
    "autoload": {
        "psr-4": {
            "Ordinal\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Ordinal\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:unit": "phpunit --testsuite Unit",
        "test:integration": "phpunit --testsuite Integration",
        "migrate": "@php bin/migrate.php"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": false
    }
}
